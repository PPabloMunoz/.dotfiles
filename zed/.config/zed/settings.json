{
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "oswe-vscode-prime",
    },
    "model_parameters": [],
  },
  "telemetry": { "diagnostics": false, "metrics": false },
  "tabs": { "git_status": true },
  "features": { "edit_prediction_provider": "copilot" },
  "colorize_brackets": true,
  "format_on_save": "on",
  "disable_ai": false,
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "icon_theme": "Catppuccin Mocha",
  "base_keymap": "VSCode",
  "scrollbar": { "show": "never" },
  "terminal": { "font_size": 13 },
  "ui_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 600,
  "buffer_font_size": 15,
  "theme": { "mode": "system", "light": "One Light", "dark": "Tokyo Night" },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 100,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "minimap": { "max_width_columns": 120, "show": "auto" },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/node_modules",
    "**/.tanstack",
  ],
  "git_panel": { "status_style": "icon", "dock": "right" },
  "outline_panel": { "dock": "left" },
  // Move some unnecessary panels to the left
  "notification_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "auto_install_extensions": {
    "tokyo-night": true,
    "catppuccin-icons": true,
  },
  "ssh_connections": [
    {
      "host": "fso.lab.inf.uva.es",
      "username": "pamunoz",
      "port": 666,
      "args": [],
      "projects": [{ "paths": ["/home/J4/pamunoz/fso"] }],
      "nickname": "FSO",
    },
    {
      "host": "192.168.0.88",
      "args": [],
      "projects": [{ "paths": ["/home/pablomunoz/flux/"] }],
      "nickname": "Raspberry Pi 4",
    },
  ],
}
